# Copy to .env on the Raspberry Pi. Never commit the real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password
PORT=8080
HOST_NAME=raspberrypi5
TIMEZONE=Europe/Berlin
RETENTION_DAYS=365
SAMBA_PATHS=/srv/samba
COLLECTOR_ENABLED=true
SQL_CONSOLE_ENABLED=false
AUDIT_LOG=/host/var/log/audit/audit.log
AUTH_LOG=/host/var/log/auth.log
SAMBA_LOG_GLOB=/host/var/log/samba/log.*
SAMBA_CONTAINER=samba
STATE_DIR=/data
