    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
